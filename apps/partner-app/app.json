{
  "expo": {
    "name": "Restaurant Partner Portal",
    "slug": "restaurant-partner-portal",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "iq.restaurantplatform.partnerapp",
      "adaptiveIcon": {
        "backgroundColor": "#212328",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos to upload restaurant content."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow the app to use your current location to pin your restaurant more accurately on the map."
        }
      ]
    ]
  }
}
