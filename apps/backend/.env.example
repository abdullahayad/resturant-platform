# Local dev database (matches docker-compose.yml at repo root)
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant_platform?schema=public"

# S3-compatible storage (MinIO locally, matches docker-compose.yml)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="restaurant-platform"
STORAGE_ACCESS_KEY="restaurant"
STORAGE_SECRET_KEY="restaurant123"
STORAGE_FORCE_PATH_STYLE="true"

# Auth
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# Payment Accounts (Settings & Staff) - encrypts each restaurant's saved
# ZainCash/Qi Card merchant secret at rest. Must be a base64-encoded 32-byte
# key, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_CREDENTIALS_ENCRYPTION_KEY="dev-only-change-me-32-bytes-b64"

PORT=3000
