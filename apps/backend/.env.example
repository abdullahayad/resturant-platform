# Local dev database (matches docker-compose.yml at repo root)
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant_platform?schema=public"

# S3-compatible storage (MinIO locally, matches docker-compose.yml)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="restaurant-platform"
STORAGE_ACCESS_KEY="restaurant"
STORAGE_SECRET_KEY="restaurant123"
STORAGE_FORCE_PATH_STYLE="true"

# Auth
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

PORT=3000
