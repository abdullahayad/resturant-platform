// Restaurant Partner Portal + Admin Control Portal
// Data model skeleton per project spec. Business logic / validation lives in
// the NestJS service layer, not here — this defines shape and relations only.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum RestaurantStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum StaffRole {
  OWNER
  MANAGER
  MENU_EDITOR
}

enum GalleryAlbum {
  FOOD
  MENU
  AMBIENCE
}

enum ChefRole {
  HEAD_CHEF
  SOUS_CHEF
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionScope {
  WHOLE_MENU
  SPECIFIC_DISHES
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Ambience album sub-tabs. Food album sub-tabs are derived from menu
// categories at query time (not stored), except MOST_ORDERED which is a flag.
enum AmbienceSubCategory {
  OUTDOOR
  INDOOR
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ModerationStatus {
  VISIBLE
  FLAGGED
  HIDDEN
}

// ────────────────────────────────────────────────────────────────────────────
// Admin-managed master / reference data
// Every list the partner app reads from is CRUD-able from the admin portal.
// ────────────────────────────────────────────────────────────────────────────

model BusinessType {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants RestaurantBusinessType[]

  @@map("business_types")
}

model FoodCategory {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants RestaurantFoodCategory[]

  @@map("food_categories")
}

// Menu Categories (soup, appetizer, grill, ...) — admin-managed for
// consistency, also drives the Food Album's per-category sub-tabs.
model MenuCategory {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dishes Dish[]

  @@map("menu_categories")
}

model Facility {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  icon      String? // icon identifier for UI
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants RestaurantFacility[]

  @@map("facilities")
}

model EventType {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  icon      String? // emoji identifier for UI
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RestaurantEvent[]

  @@map("event_types")
}

model Province {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts   District[]
  restaurants Restaurant[]

  @@map("provinces")
}

model District {
  id         String   @id @default(uuid())
  provinceId String
  nameEn     String
  nameAr     String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province    Province     @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  restaurants Restaurant[]

  @@index([provinceId])
  @@map("districts")
}

// ────────────────────────────────────────────────────────────────────────────
// Admin users
// ────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(MODERATOR)
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0) // bumped to invalidate previously issued JWTs
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedRestaurants Restaurant[]         @relation("RestaurantReviewedBy")
  reviewReplyActions  ReviewReply[]        @relation("ReviewReplyModeratedBy")
  sentNotifications   AdminNotification[]
  reviewedPromotions  Promotion[]

  @@map("admin_users")
}

// ────────────────────────────────────────────────────────────────────────────
// Restaurant core
// ────────────────────────────────────────────────────────────────────────────

model Restaurant {
  id         String           @id @default(uuid())
  codeNumber String           @unique // formatted as #IRQ-XXXXX at the API layer
  nameEn     String
  nameAr     String
  phone      String
  logoUrl    String?
  status     RestaurantStatus @default(PENDING_REVIEW)

  provinceId String?
  districtId String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)

  // Auth (owner account created at sign-up)
  ownerEmail        String @unique
  ownerPasswordHash String
  tokenVersion      Int    @default(0) // bumped on password change to invalidate previously issued JWTs

  // Notification preferences (Settings & Staff)
  notifyNewReview  Boolean @default(true)
  notifyNewBooking Boolean @default(true)

  // Admin-controlled: whether the partner can see their own Overview
  // Dashboard performance numbers (Diner Satisfaction, Chef Table
  // Bookings). Off by default for newly approved restaurants; an admin
  // switches it on later.
  statsVisible Boolean @default(false)

  // Chef Management: kitchen crew headcount + one representative photo.
  // Individual chef/sous chef profiles live in ChefProfile.
  crewCount    Int?
  crewPhotoUrl String?

  // Admin moderation trail
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  province   Province?  @relation(fields: [provinceId], references: [id])
  district   District?  @relation(fields: [districtId], references: [id])
  reviewedBy AdminUser? @relation("RestaurantReviewedBy", fields: [reviewedById], references: [id])

  businessTypes     RestaurantBusinessType[]
  foodCategories    RestaurantFoodCategory[]
  facilities        RestaurantFacility[]
  dishes            Dish[]
  galleryPhotos     GalleryPhoto[]
  stories           Story[]
  reviews           Review[]
  chefTableBookings ChefTableBooking[]
  staffUsers        PartnerStaffUser[]
  openingHours      OpeningHours[]
  events            RestaurantEvent[]
  chefProfiles      ChefProfile[]
  notifications     NotificationRecipient[]
  promotions        Promotion[]

  @@index([status])
  @@index([provinceId])
  @@index([districtId])
  @@map("restaurants")
}

model RestaurantBusinessType {
  restaurantId   String
  businessTypeId String

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  @@id([restaurantId, businessTypeId])
  @@map("restaurant_business_types")
}

model RestaurantFoodCategory {
  restaurantId   String
  foodCategoryId String

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodCategory FoodCategory @relation(fields: [foodCategoryId], references: [id], onDelete: Cascade)

  @@id([restaurantId, foodCategoryId])
  @@map("restaurant_food_categories")
}

model RestaurantFacility {
  restaurantId String
  facilityId   String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([restaurantId, facilityId])
  @@map("restaurant_facilities")
}

// ────────────────────────────────────────────────────────────────────────────
// Menu
// ────────────────────────────────────────────────────────────────────────────

model Dish {
  id             String   @id @default(uuid())
  restaurantId   String
  menuCategoryId String?
  nameEn         String
  nameAr         String
  price          Decimal  @db.Decimal(10, 2)
  photoUrl       String?
  isMostOrdered  Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory  MenuCategory?   @relation(fields: [menuCategoryId], references: [id])
  galleryPhotos GalleryPhoto[]
  promotions    PromotionDish[]

  @@index([restaurantId])
  @@index([menuCategoryId])
  @@map("dishes")
}

// ────────────────────────────────────────────────────────────────────────────
// Gallery — 3 albums: Food (sub-tabbed by menu category + Most Ordered),
// Menu (paper menu photos only), Ambience (Outdoor/Indoor/Other)
// ────────────────────────────────────────────────────────────────────────────

model GalleryPhoto {
  id                  String               @id @default(uuid())
  restaurantId        String
  album               GalleryAlbum
  // Food album only: links the photo to a specific dish so it can be
  // grouped under that dish's menu-category sub-tab.
  dishId              String?
  // Ambience album only
  ambienceSubCategory AmbienceSubCategory?
  url                 String
  caption             String?
  createdAt           DateTime             @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish       Dish?      @relation(fields: [dishId], references: [id])

  @@index([restaurantId, album])
  @@map("gallery_photos")
}

// ────────────────────────────────────────────────────────────────────────────
// 24-hour story
// ────────────────────────────────────────────────────────────────────────────

model Story {
  id           String   @id @default(uuid())
  restaurantId String
  mediaUrl     String
  mediaType    String // "photo" | "video"
  caption      String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime // createdAt + 24h, enforced at write time

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([expiresAt])
  @@map("stories")
}

// ────────────────────────────────────────────────────────────────────────────
// Chef Management
// ────────────────────────────────────────────────────────────────────────────

model ChefProfile {
  id              String   @id @default(uuid())
  restaurantId    String
  role            ChefRole
  name            String
  photoUrl        String?
  speciality      String?
  yearsExperience Int?
  awards          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, role])
  @@map("chef_profiles")
}

// ────────────────────────────────────────────────────────────────────────────
// Reviews
// ────────────────────────────────────────────────────────────────────────────

model Review {
  id               String           @id @default(uuid())
  restaurantId     String
  reviewerName     String
  rating           Int // overall, 1-5
  foodRating       Int? // 1-5, category breakdown per spec ("Category Scores & 30-Day Trends")
  serviceRating    Int?
  staffRating      Int?
  ambienceRating   Int?
  text             String?
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reply      ReviewReply?

  @@index([restaurantId])
  @@index([moderationStatus])
  @@map("reviews")
}

model ReviewReply {
  id            String   @id @default(uuid())
  reviewId      String   @unique
  text          String
  moderatedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  review      Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderatedBy AdminUser? @relation("ReviewReplyModeratedBy", fields: [moderatedById], references: [id])

  @@map("review_replies")
}

// ────────────────────────────────────────────────────────────────────────────
// Chef Table & Events
// ────────────────────────────────────────────────────────────────────────────

// A reservation request against a specific RestaurantEvent occurrence.
// reservationDate is the specific date being requested — for a recurring
// event (e.g. "every Friday") this is which Friday, not just a timestamp.
model ChefTableBooking {
  id              String        @id @default(uuid())
  restaurantId    String
  eventId         String
  guestName       String
  guestPhone      String
  partySize       Int
  reservationDate DateTime
  status          BookingStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event      RestaurantEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([eventId, reservationDate])
  @@map("chef_table_bookings")
}

// Restaurant-created event listings (buffet nights, live music, chef's
// table, etc.) shown under the partner app's "Chef Table & Events" screen.
// Announcement-only for now — no RSVP/booking flow (see ChefTableBooking
// above for that, unused until a customer app exists to book against it).
model RestaurantEvent {
  id            String   @id @default(uuid())
  restaurantId  String
  eventTypeId   String
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  photoUrl      String?
  price         Decimal? @db.Decimal(10, 2)
  capacity      Int? // max total guests per reservation date; null = unlimited

  isRecurring        Boolean   @default(false)
  eventDate          DateTime? // one-off events: specific date & time
  recurringDayOfWeek Int? // recurring events: 0 = Sunday ... 6 = Saturday
  recurringTime      String? // recurring events: "HH:mm"

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  eventType    EventType          @relation(fields: [eventTypeId], references: [id])
  reservations ChefTableBooking[]

  @@index([restaurantId, isActive])
  @@map("restaurant_events")
}

// ────────────────────────────────────────────────────────────────────────────
// Promotions — restaurant-authored discounts, admin-moderated before going
// live. Discount applies to the whole menu or a specific set of dishes;
// scheduling is either a one-off date range or a recurring day-of-week with
// an optional time window (an all-day recurring promo is a "day special",
// one with startTime/endTime is a "happy hour").
// ────────────────────────────────────────────────────────────────────────────

model Promotion {
  id            String   @id @default(uuid())
  restaurantId  String
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  photoUrl      String?

  discountType  PromotionDiscountType
  discountValue Decimal @db.Decimal(10, 2) // percentage (0-100] or a fixed IQD amount
  scope         PromotionScope

  isRecurring        Boolean   @default(false)
  validFrom          DateTime? // one-off: start of the date range
  validUntil         DateTime? // one-off: end of the date range
  recurringDayOfWeek Int? // recurring: 0 = Sunday ... 6 = Saturday
  startTime          String? // recurring: "HH:mm", omitted = all day
  endTime            String? // recurring: "HH:mm", omitted = all day

  status          PromotionStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  isActive  Boolean  @default(true) // restaurant-side on/off switch, independent of moderation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser?        @relation(fields: [reviewedById], references: [id])
  dishes     PromotionDish[]

  @@index([restaurantId, status])
  @@map("promotions")
}

model PromotionDish {
  id          String @id @default(uuid())
  promotionId String
  dishId      String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  dish      Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([promotionId, dishId])
  @@map("promotion_dishes")
}

// ────────────────────────────────────────────────────────────────────────────
// Partner staff (Settings & Staff)
// ────────────────────────────────────────────────────────────────────────────

model PartnerStaffUser {
  id           String    @id @default(uuid())
  restaurantId String
  email        String    @unique
  passwordHash String
  fullName     String
  role         StaffRole @default(MENU_EDITOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("partner_staff_users")
}

// ────────────────────────────────────────────────────────────────────────────
// Opening hours (Profile & Info)
// ────────────────────────────────────────────────────────────────────────────

model OpeningHours {
  id           String  @id @default(uuid())
  restaurantId String
  dayOfWeek    Int // 0 = Sunday ... 6 = Saturday (JS Date.getDay() convention)
  isClosed     Boolean @default(false)
  openTime     String? // "HH:mm", 24-hour
  closeTime    String? // "HH:mm", 24-hour

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@map("opening_hours")
}

// ────────────────────────────────────────────────────────────────────────────
// Admin broadcast notifications
// ────────────────────────────────────────────────────────────────────────────

// A message an admin sends to a set of restaurants, resolved to an explicit
// recipient list at creation time (NotificationRecipient rows) rather than
// re-evaluating the target filter on every read, so the recipient set stays
// fixed even if a restaurant's province/business-type changes afterwards.
model AdminNotification {
  id             String   @id @default(uuid())
  titleEn        String
  titleAr        String
  bodyEn         String
  bodyAr         String
  actionRequired Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())

  createdBy  AdminUser                @relation(fields: [createdById], references: [id])
  recipients NotificationRecipient[]

  @@map("admin_notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  restaurantId   String
  readAt         DateTime?
  acknowledgedAt DateTime?

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([notificationId, restaurantId])
  @@index([restaurantId])
  @@map("notification_recipients")
}
