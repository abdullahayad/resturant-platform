// Restaurant Partner Portal + Admin Control Portal
// Data model skeleton per project spec. Business logic / validation lives in
// the NestJS service layer, not here — this defines shape and relations only.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum RestaurantStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum StaffRole {
  OWNER
  MANAGER
  MENU_EDITOR
}

enum GalleryAlbum {
  FOOD
  MENU
  AMBIENCE
  REVIEW
}

enum ChefRole {
  HEAD_CHEF
  SOUS_CHEF
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionScope {
  WHOLE_MENU
  SPECIFIC_DISHES
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeaturedStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeaturedInitiator {
  RESTAURANT
  ADMIN
}

// Ambience album sub-tabs. Food album sub-tabs are derived from menu
// categories at query time (not stored), except MOST_ORDERED which is a flag.
enum AmbienceSubCategory {
  OUTDOOR
  INDOOR
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ModerationStatus {
  VISIBLE
  FLAGGED
  HIDDEN
}

// One-time go-live gate, separate from RestaurantStatus (registration
// approval). NOT_SUBMITTED is the initial state since Restaurant rows exist
// before submission, unlike Promotion/Featured which are only created
// already PENDING.
enum PublishStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

// ────────────────────────────────────────────────────────────────────────────
// Admin-managed master / reference data
// Every list the partner app reads from is CRUD-able from the admin portal.
// ────────────────────────────────────────────────────────────────────────────

model BusinessType {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants RestaurantBusinessType[]

  @@map("business_types")
}

model FoodCategory {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants RestaurantFoodCategory[]

  @@map("food_categories")
}

// Menu Categories (soup, appetizer, grill, ...) — admin-managed for
// consistency, also drives the Food Album's per-category sub-tabs.
model MenuCategory {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dishes Dish[]

  @@map("menu_categories")
}

model Facility {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  icon      String? // icon identifier for UI
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants RestaurantFacility[]

  @@map("facilities")
}

model EventType {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  icon      String? // emoji identifier for UI
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RestaurantEvent[]

  @@map("event_types")
}

model Province {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  // Two-letter code used as the first segment of every restaurant code in
  // this province (e.g. "BG" for Baghdad -> BGKR001). Admin-editable.
  code      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts   District[]
  restaurants Restaurant[]
  featureFlagOverrides FeatureFlagOverride[]

  @@map("provinces")
}

model District {
  id         String   @id @default(uuid())
  provinceId String
  nameEn     String
  nameAr     String
  // Two-letter code, unique within its own province (not globally - the
  // province code already disambiguates). Second segment of the restaurant
  // code (e.g. "KR" for Karkh -> BGKR001).
  code       String
  // Running counter for this district's restaurant codes - incremented
  // atomically (raw SQL UPDATE ... RETURNING) at registration time so two
  // restaurants registering in the same district at once can't collide.
  nextCodeSeq Int     @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province    Province     @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  restaurants Restaurant[]
  featureFlagOverrides FeatureFlagOverride[]

  @@unique([provinceId, code])
  @@index([provinceId])
  @@map("districts")
}

// ────────────────────────────────────────────────────────────────────────────
// Admin users
// ────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(MODERATOR)
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0) // bumped to invalidate previously issued JWTs
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedRestaurants        Restaurant[]         @relation("RestaurantReviewedBy")
  publishReviewedRestaurants Restaurant[]         @relation("RestaurantPublishReviewedBy")
  reviewReplyActions         ReviewReply[]        @relation("ReviewReplyModeratedBy")
  sentNotifications          AdminNotification[]
  reviewedPromotions         Promotion[]
  reviewedFeatured           FeaturedPlacement[]
  issuedLoyaltyRewards       LoyaltyReward[]

  @@map("admin_users")
}

// ────────────────────────────────────────────────────────────────────────────
// Restaurant core
// ────────────────────────────────────────────────────────────────────────────

model Restaurant {
  id         String           @id @default(uuid())
  codeNumber String           @unique // e.g. "BGKR001" - province code + district code + a number that resets per district, see RestaurantsService.generateCodeNumber
  nameEn     String
  nameAr     String
  phone      String           @unique
  logoUrl    String?
  status     RestaurantStatus @default(PENDING_REVIEW)

  provinceId String?
  districtId String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  // Kept in sync with latitude/longitude by a DB trigger (see the
  // add_restaurant_geography migration), not written to directly anywhere
  // in application code - Prisma has no native geography scalar, so this
  // is Unsupported and only reachable via $queryRaw. Exists now, ahead of
  // any "restaurants near me" feature, specifically so that feature can
  // use a real spatial (GiST) index from day one instead of the app
  // fetching every restaurant and computing distance in JS - retrofitting
  // this after restaurants have accumulated would mean a real migration
  // instead of just turning a search feature on.
  location   Unsupported("geography(Point, 4326)")?

  // Auth (owner account created at sign-up)
  ownerEmail        String    @unique
  ownerPasswordHash String
  tokenVersion      Int       @default(0) // bumped on password change to invalidate previously issued JWTs
  termsAcceptedAt   DateTime? // set at registration when the owner checks the terms/privacy agreement

  // Forgot-password: a hash of the emailed 6-digit code, never the code
  // itself, same reasoning as ownerPasswordHash — cleared on successful
  // reset or once expired.
  passwordResetCodeHash  String?
  passwordResetExpiresAt DateTime?

  // Notification preferences (Settings & Staff)
  notifyNewReview  Boolean @default(true)
  notifyNewBooking Boolean @default(true)

  // Admin-controlled: whether the partner can see their own Overview
  // Dashboard performance numbers (Diner Satisfaction, Chef Table
  // Bookings). Off by default for newly approved restaurants; an admin
  // switches it on later.
  statsVisible Boolean @default(false)

  // Daily cap on AI review-reply suggestions (see ReviewsService.suggestReply)
  // - resets whenever aiSuggestionCountDate is no longer today, checked and
  // incremented atomically in one UPDATE so two simultaneous requests can't
  // both slip in under the cap.
  aiSuggestionCount     Int       @default(0)
  aiSuggestionCountDate DateTime?

  // Chef Management: kitchen crew headcount + one representative photo.
  // Individual chef/sous chef profiles live in ChefProfile.
  crewCount    Int?
  crewPhotoUrl String?

  // Payment Accounts (Settings & Staff) - each restaurant's own ZainCash /
  // Qi Card merchant credentials, so a future customer-app checkout can
  // charge a customer straight into this restaurant's own account (the
  // platform never holds the money). The secret is encrypted at rest (see
  // common/secretEncryption.ts) and never sent back to the frontend once
  // saved - only merchantId + connectedAt are, so the UI can show
  // "Connected" without ever displaying the key again. Not used by any
  // live payment flow yet; there is no customer app to trigger one.
  zainCashMerchantId      String?
  zainCashSecretEncrypted String?
  zainCashConnectedAt     DateTime?
  qiCardMerchantId        String?
  qiCardSecretEncrypted   String?
  qiCardConnectedAt       DateTime?

  // Admin moderation trail
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  // Publish/go-live gate — separate one-time stage from registration
  // approval above. Does not affect ApprovedPartnerGuard/partner-app access;
  // it only records a "confirmed profile-complete" checkpoint. If declined,
  // the restaurant cannot resubmit on their own — an admin must reopen it
  // (see RestaurantsService.reopenPublish) before they can submit again.
  publishStatus          PublishStatus @default(NOT_SUBMITTED)
  publishSubmittedAt     DateTime?
  publishRejectionReason String?
  publishReviewedById    String?
  publishReviewedAt      DateTime?
  // Set only once the restaurant explicitly dismisses a decline notice
  // (Mark as Done) — reset to null on every fresh decline and on
  // resubmission, so a repeat decline shows as unacknowledged again.
  publishDeclineAcknowledgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  province          Province?  @relation(fields: [provinceId], references: [id])
  district          District?  @relation(fields: [districtId], references: [id])
  reviewedBy        AdminUser? @relation("RestaurantReviewedBy", fields: [reviewedById], references: [id])
  publishReviewedBy AdminUser? @relation("RestaurantPublishReviewedBy", fields: [publishReviewedById], references: [id])

  businessTypes     RestaurantBusinessType[]
  foodCategories    RestaurantFoodCategory[]
  facilities        RestaurantFacility[]
  dishes            Dish[]
  galleryPhotos     GalleryPhoto[]
  stories           Story[]
  reviews           Review[]
  chefTableBookings ChefTableBooking[]
  staffUsers        PartnerStaffUser[]
  openingHours      OpeningHours[]
  events            RestaurantEvent[]
  chefProfiles      ChefProfile[]
  notifications     NotificationRecipient[]
  promotions        Promotion[]
  featuredPlacements FeaturedPlacement[]
  pushTokens        RestaurantPushToken[]
  featureFlagOverrides FeatureFlagOverride[]

  @@index([status])
  @@index([publishStatus])
  @@index([provinceId])
  @@index([districtId])
  @@map("restaurants")
}

model RestaurantBusinessType {
  restaurantId   String
  businessTypeId String

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  @@id([restaurantId, businessTypeId])
  @@map("restaurant_business_types")
}

model RestaurantFoodCategory {
  restaurantId   String
  foodCategoryId String

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodCategory FoodCategory @relation(fields: [foodCategoryId], references: [id], onDelete: Cascade)

  @@id([restaurantId, foodCategoryId])
  @@map("restaurant_food_categories")
}

model RestaurantFacility {
  restaurantId String
  facilityId   String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([restaurantId, facilityId])
  @@map("restaurant_facilities")
}

// ────────────────────────────────────────────────────────────────────────────
// Menu
// ────────────────────────────────────────────────────────────────────────────

model Dish {
  id             String   @id @default(uuid())
  restaurantId   String
  menuCategoryId String?
  nameEn         String
  nameAr         String
  price          Decimal  @db.Decimal(10, 2)
  photoUrl       String?
  isMostOrdered  Boolean  @default(false)
  isActive       Boolean  @default(true)
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory     MenuCategory?       @relation(fields: [menuCategoryId], references: [id])
  galleryPhotos    GalleryPhoto[]
  promotions       PromotionDish[]
  chefSignatures   ChefSignatureDish[]

  @@index([restaurantId])
  @@index([menuCategoryId])
  @@index([moderationStatus])
  @@map("dishes")
}

// ────────────────────────────────────────────────────────────────────────────
// Gallery — 3 albums: Food (sub-tabbed by menu category + Most Ordered),
// Menu (paper menu photos only), Ambience (Outdoor/Indoor/Other)
// ────────────────────────────────────────────────────────────────────────────

model GalleryPhoto {
  id                  String               @id @default(uuid())
  restaurantId        String
  album               GalleryAlbum
  // Food album only: links the photo to a specific dish so it can be
  // grouped under that dish's menu-category sub-tab.
  dishId              String?
  // Ambience album only
  ambienceSubCategory AmbienceSubCategory?
  // Review album only: links back to the review a customer attached this
  // photo to when posting it.
  reviewId            String?
  url                 String
  caption             String?
  // At most one true per (restaurantId, album) - enforced in
  // GalleryService.setCover via a transaction, not a DB constraint, since a
  // partial unique index isn't expressible in Prisma's schema DSL. Shown
  // first within its album (see list()'s orderBy) - the owner's own pick of
  // their best shot, independent of whenever a public customer-facing app
  // exists to also show it there.
  isCover             Boolean              @default(false)
  moderationStatus    ModerationStatus     @default(VISIBLE)
  createdAt           DateTime             @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish       Dish?      @relation(fields: [dishId], references: [id])
  review     Review?    @relation(fields: [reviewId], references: [id])

  @@index([restaurantId, album])
  @@index([moderationStatus])
  @@map("gallery_photos")
}

// ────────────────────────────────────────────────────────────────────────────
// 24-hour story
// ────────────────────────────────────────────────────────────────────────────

model Story {
  id           String   @id @default(uuid())
  restaurantId String
  mediaUrl     String
  mediaType    String // "photo" | "video"
  caption      String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime // createdAt + 24h, enforced at write time

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([expiresAt])
  @@map("stories")
}

// ────────────────────────────────────────────────────────────────────────────
// Chef Management
// ────────────────────────────────────────────────────────────────────────────

model ChefProfile {
  id              String   @id @default(uuid())
  restaurantId    String
  role            ChefRole
  name            String
  photoUrl        String?
  speciality      String?
  yearsExperience Int?
  awards          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  signatureDishes ChefSignatureDish[]

  @@unique([restaurantId, role])
  @@map("chef_profiles")
}

// A chef's hand-picked dishes from the restaurant's own menu (e.g. "Head
// Chef -> Lamb Quzi, Grilled Kebab") - same explicit join-table shape as
// PromotionDish below, for the same reason: a chef can have several
// signature dishes and (in principle) a dish could be credited to more
// than one chef.
model ChefSignatureDish {
  id            String @id @default(uuid())
  chefProfileId String
  dishId        String

  chefProfile ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade)
  dish        Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([chefProfileId, dishId])
  @@map("chef_signature_dishes")
}

// ────────────────────────────────────────────────────────────────────────────
// Reviews
// ────────────────────────────────────────────────────────────────────────────

model Review {
  id               String           @id @default(uuid())
  restaurantId     String
  reviewerName     String
  rating           Int // overall, 1-5
  foodRating       Int? // 1-5, category breakdown per spec ("Category Scores & 30-Day Trends")
  serviceRating    Int?
  staffRating      Int?
  ambienceRating   Int?
  text             String?
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reply      ReviewReply?
  // Photos the customer attached when posting this review — stored as
  // GalleryPhoto rows tagged album: REVIEW, so they also show up in the
  // restaurant's own gallery and go through the same moderation flow.
  photos     GalleryPhoto[]

  @@index([restaurantId])
  @@index([moderationStatus])
  @@map("reviews")
}

model ReviewReply {
  id            String   @id @default(uuid())
  reviewId      String   @unique
  text          String
  moderatedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  review      Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderatedBy AdminUser? @relation("ReviewReplyModeratedBy", fields: [moderatedById], references: [id])

  @@map("review_replies")
}

// ────────────────────────────────────────────────────────────────────────────
// Chef Table & Events
// ────────────────────────────────────────────────────────────────────────────

// A reservation request against a specific RestaurantEvent occurrence.
// reservationDate is the specific date being requested — for a recurring
// event (e.g. "every Friday") this is which Friday, not just a timestamp.
model ChefTableBooking {
  id                   String        @id @default(uuid())
  restaurantId         String
  eventId              String
  guestName            String
  guestPhone           String
  // Derived from guestPhone at write time (see common/phone.ts) — used for
  // all loyalty-program matching so the same guest is recognized across
  // restaurants regardless of how staff typed their number.
  guestPhoneNormalized String
  partySize            Int
  reservationDate      DateTime
  status               BookingStatus @default(PENDING)
  notes                String?
  // Client-generated, one per genuine booking attempt (not per HTTP
  // request) - lets createReservation recognize a resubmission (e.g. a
  // customer double-tapping "Book" after the app looked like it hung) and
  // hand back the original booking instead of creating a second one.
  // Globally unique rather than scoped per-event: a client-generated UUID
  // colliding by chance is practically impossible, so a flat unique
  // constraint is simpler than a composite one for the same guarantee.
  idempotencyKey       String        @unique

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event      RestaurantEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([eventId, reservationDate])
  @@index([guestPhoneNormalized, status])
  @@map("chef_table_bookings")
}

// ────────────────────────────────────────────────────────────────────────────
// Guest loyalty program — platform-wide (not per-restaurant), tracked by
// guest phone number since there's no customer account system yet.
// ────────────────────────────────────────────────────────────────────────────

// Admin-configured tiers, e.g. "Silver" at 3 qualifying bookings, "Gold" at 6.
// Deactivated (isActive: false) rather than deleted once a reward exists
// against them, so issuance history stays intact.
model LoyaltyTier {
  id             String   @id @default(uuid())
  labelEn        String
  labelAr        String
  thresholdCount Int // minimum qualifying (CONFIRMED/COMPLETED) bookings across all restaurants
  rewardEn       String // e.g. "10% off next visit"
  rewardAr       String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rewards LoyaltyReward[]

  @@map("loyalty_tiers")
}

// An issued reward tied to a guest's phone number, not a restaurant.
// Snapshots the tier's label/reward text at issuance time so later tier
// edits don't rewrite history for rewards already granted. issuedById is
// null for system-auto-issued rewards (threshold crossed) and set for a
// manual grant. Redemption is manual/trust-based — the restaurant honors it
// in person and an admin marks it redeemed here for bookkeeping; there is
// no automated customer notification or redemption-code flow.
model LoyaltyReward {
  id                     String    @id @default(uuid())
  guestPhone             String // normalized form — see common/phone.ts
  tierId                 String
  tierLabelEn            String
  tierLabelAr            String
  rewardEn               String
  rewardAr               String
  bookingCountAtIssuance Int
  issuedById             String?
  issuedAt               DateTime  @default(now())
  redeemedAt             DateTime?
  redeemedNote           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tier     LoyaltyTier @relation(fields: [tierId], references: [id])
  issuedBy AdminUser?  @relation(fields: [issuedById], references: [id])

  @@unique([guestPhone, tierId])
  @@index([guestPhone])
  @@map("loyalty_rewards")
}

// Restaurant-created event listings (buffet nights, live music, chef's
// table, etc.) shown under the partner app's "Chef Table & Events" screen.
// Announcement-only for now — no RSVP/booking flow (see ChefTableBooking
// above for that, unused until a customer app exists to book against it).
model RestaurantEvent {
  id            String   @id @default(uuid())
  restaurantId  String
  eventTypeId   String
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  photoUrl      String?
  price         Decimal? @db.Decimal(10, 2)
  capacity      Int? // max total guests per reservation date; null = unlimited

  isRecurring        Boolean   @default(false)
  eventDate          DateTime? // one-off events: specific date & time
  recurringDayOfWeek Int? // recurring events: 0 = Sunday ... 6 = Saturday
  recurringTime      String? // recurring events: "HH:mm"

  isActive  Boolean  @default(true)
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  eventType    EventType          @relation(fields: [eventTypeId], references: [id])
  reservations ChefTableBooking[]

  @@index([restaurantId, isActive])
  @@index([moderationStatus])
  @@map("restaurant_events")
}

// ────────────────────────────────────────────────────────────────────────────
// Promotions — restaurant-authored discounts, admin-moderated before going
// live. Discount applies to the whole menu or a specific set of dishes;
// scheduling is either a one-off date range or a recurring day-of-week with
// an optional time window (an all-day recurring promo is a "day special",
// one with startTime/endTime is a "happy hour").
// ────────────────────────────────────────────────────────────────────────────

model Promotion {
  id            String   @id @default(uuid())
  restaurantId  String
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  photoUrl      String?

  discountType  PromotionDiscountType
  discountValue Decimal @db.Decimal(10, 2) // percentage (0-100] or a fixed IQD amount
  scope         PromotionScope

  isRecurring        Boolean   @default(false)
  validFrom          DateTime? // one-off: start of the date range
  validUntil         DateTime? // one-off: end of the date range
  recurringDayOfWeek Int? // recurring: 0 = Sunday ... 6 = Saturday
  startTime          String? // recurring: "HH:mm", omitted = all day
  endTime            String? // recurring: "HH:mm", omitted = all day

  status          PromotionStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  isActive  Boolean  @default(true) // restaurant-side on/off switch, independent of moderation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser?        @relation(fields: [reviewedById], references: [id])
  dishes     PromotionDish[]

  @@index([restaurantId, status])
  @@map("promotions")
}

model PromotionDish {
  id          String @id @default(uuid())
  promotionId String
  dishId      String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  dish      Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([promotionId, dishId])
  @@map("promotion_dishes")
}

// ────────────────────────────────────────────────────────────────────────────
// Featured placement — advertising/visibility, distinct from Promotions
// (which are the restaurant's own menu discounts). A restaurant can request
// to be featured, or an admin can grant it directly without a request
// (initiator tracks which happened). Either way it goes through the same
// PENDING -> APPROVED/REJECTED lifecycle an admin controls; date range is
// optional (open-ended until an admin ends it).
// ────────────────────────────────────────────────────────────────────────────

model FeaturedPlacement {
  id           String            @id @default(uuid())
  restaurantId String
  initiator    FeaturedInitiator
  reason       String? // restaurant's stated reason when requesting
  note         String? // admin's internal note, e.g. why they granted it directly

  startDate DateTime?
  endDate   DateTime?

  status          FeaturedStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  isActive  Boolean  @default(true) // lets an admin end an approved placement early
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation(fields: [reviewedById], references: [id])

  @@index([restaurantId, status])
  @@map("featured_placements")
}

// ────────────────────────────────────────────────────────────────────────────
// Partner staff (Settings & Staff)
// ────────────────────────────────────────────────────────────────────────────

model PartnerStaffUser {
  id           String    @id @default(uuid())
  restaurantId String
  email        String    @unique
  passwordHash String
  fullName     String
  role         StaffRole @default(MENU_EDITOR)
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0) // bumped on password change to invalidate previously issued JWTs
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Same forgot/reset-password fields as Restaurant.ownerEmail's flow — lets a
  // staff member who forgot their invite-time temp password recover on their
  // own via the same "Forgot password?" link, instead of admin having to
  // delete and re-invite them.
  passwordResetCodeHash  String?
  passwordResetExpiresAt DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("partner_staff_users")
}

// ────────────────────────────────────────────────────────────────────────────
// Opening hours (Profile & Info)
// ────────────────────────────────────────────────────────────────────────────

model OpeningHours {
  id           String  @id @default(uuid())
  restaurantId String
  dayOfWeek    Int // 0 = Sunday ... 6 = Saturday (JS Date.getDay() convention)
  isClosed     Boolean @default(false)
  openTime     String? // "HH:mm", 24-hour
  closeTime    String? // "HH:mm", 24-hour

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@map("opening_hours")
}

// ────────────────────────────────────────────────────────────────────────────
// Admin broadcast notifications
// ────────────────────────────────────────────────────────────────────────────

// A message an admin sends to a set of restaurants, resolved to an explicit
// recipient list at creation time (NotificationRecipient rows) rather than
// re-evaluating the target filter on every read, so the recipient set stays
// fixed even if a restaurant's province/business-type changes afterwards.
model AdminNotification {
  id             String   @id @default(uuid())
  titleEn        String
  titleAr        String
  bodyEn         String
  bodyAr         String
  actionRequired Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())

  createdBy  AdminUser                @relation(fields: [createdById], references: [id])
  recipients NotificationRecipient[]

  @@map("admin_notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  restaurantId   String
  readAt         DateTime?
  acknowledgedAt DateTime?
  // One reply per recipient, not a thread — "who sent it" is already this row's
  // own restaurant relation, so no separate author field is needed.
  replyText      String?
  repliedAt      DateTime?
  // Set once an admin has actually opened this notification's recipient list
  // and seen the reply — powers the "N new replies" badge on the admin list.
  replySeenAt    DateTime?

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([notificationId, restaurantId])
  @@index([restaurantId])
  @@map("notification_recipients")
}

// One row per device that has registered for push notifications — a restaurant
// with a manager on their phone and staff on a tablet can have several. Tokens
// are Expo push tokens (opaque strings from expo-notifications), unique per
// device/app-install, not per restaurant.
model RestaurantPushToken {
  id           String   @id @default(uuid())
  restaurantId String
  token        String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_push_tokens")
}

// ────────────────────────────────────────────────────────────────────────────
// Feature flags — staged per-restaurant / per-region section rollout
// ────────────────────────────────────────────────────────────────────────────

// One row per flaggable partner-app sidebar section. Absence of a row for a
// given key means "always enabled" — core sections (dashboard, profile,
// settings) are never given a row here on purpose, so admin can never
// accidentally lock a restaurant out of managing their own account.
model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique // matches the partner-app's ScreenKey exactly, e.g. "chefTable"
  labelEn        String
  defaultEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

// Exactly one of restaurantId / provinceId is set per row (enforced in the
// service layer, not a DB constraint). Resolution order when checking whether
// a restaurant sees a section: restaurant-specific override wins, then
// province override, then the flag's own defaultEnabled.
model FeatureFlagOverride {
  id            String   @id @default(uuid())
  featureFlagId String
  restaurantId  String?
  districtId    String?
  provinceId    String?
  enabled       Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  restaurant  Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  district    District?   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  province    Province?   @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, restaurantId])
  @@unique([featureFlagId, districtId])
  @@unique([featureFlagId, provinceId])
  @@index([restaurantId])
  @@index([districtId])
  @@index([provinceId])
  @@map("feature_flag_overrides")
}
