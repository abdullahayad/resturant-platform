{
  "name": "restaurant-platform",
  "private": true,
  "version": "0.0.1",
  "description": "Restaurant discovery platform (Iraq) - Partner tablet app + Admin control portal + shared backend",
  "workspaces": [
    "apps/backend",
    "apps/admin-portal",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace apps/backend",
    "dev:admin": "npm run dev --workspace apps/admin-portal",
    "dev:partner": "npm --prefix apps/partner-app run start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "bcrypt@6.0.0": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
